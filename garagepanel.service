[Unit]
Description=Garage + Caddy admin panel
Documentation=https://garagehq.deuxfleurs.fr/documentation/reference-manual/admin-api/
After=network-online.target garage.service caddy.service
Wants=network-online.target

[Service]
Type=simple
User=garagepanel
Group=garagepanel
ExecStart=/usr/local/bin/garagepanel

# Token dan secret ada di file ini. Harus 0600 dan milik root (dibaca systemd
# sebelum privilege di-drop), jangan pernah taruh di ExecStart atau di unit ini.
EnvironmentFile=/etc/garagepanel/garagepanel.env

Restart=on-failure
RestartSec=5s

# --- hardening ------------------------------------------------------------
# CATATAN PENTING: NoNewPrivileges HARUS tetap "no". Panel menjalankan
# "sudo systemctl reload caddy", dan sudo butuh setuid. Kalau baris ini diubah
# ke "yes", reload akan selalu gagal dengan "sudo: effective uid is not 0".
# Untuk alasan yang sama JANGAN menambahkan RestrictSUIDSGID=yes.
#
# JANGAN pula menambahkan SystemCallFilter=. systemd mendokumentasikan bahwa
# daftar filter yang tidak kosong mengimplikasikan NoNewPrivileges=yes, dan itu
# mematikan sudo. Skor "systemd-analyze security" memang akan menyebut baris ini
# sebagai kekurangan — itu memang harga yang dibayar supaya reload Caddy jalan.
NoNewPrivileges=no

# Default umask 0022 membuat file baru bisa dibaca siapa saja. 0077 aman di sini
# karena file site di-chmod 0640 secara eksplisit oleh panel (chmod mengabaikan
# umask) — sudah diuji: hasilnya tetap garagepanel:caddy 0640 dan Caddy tetap
# bisa membacanya. Sisanya, termasuk file sementara upload, jadi 0600.
UMask=0077

ProtectSystem=full
# /etc read-only karena ProtectSystem=full, jadi direktori sites dibuka lagi:
ReadWritePaths=/etc/caddy/sites
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# AF_PACKET dan keluarga soket eksotis diblokir, tapi AF_NETLINK harus tetap
# diizinkan: diukur dengan strace, satu kali "sudo systemctl reload caddy"
# membuka 14 soket netlink (sebagian besar NETLINK_AUDIT dari libaudit di dalam
# PAM). Memblokirnya berisiko membuat satu-satunya operasi istimewa panel gagal.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Batas wajar: panel menyangga file upload sampai 50 MB di memori.
LimitNOFILE=4096
MemoryMax=512M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=garagepanel

[Install]
WantedBy=multi-user.target
